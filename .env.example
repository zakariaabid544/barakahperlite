# Barakah Perlite local email configuration
# Copy this file to `.env.local` for local development.
# Never commit `.env.local`; it contains the real OVH mailbox password.
#
# Vercel later:
# Add the same variables in Project Settings -> Environment Variables
# for Preview and Production deployments.

SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@barakahperlite.com
SMTP_PASSWORD=YOUR_OVH_EMAIL_PASSWORD
CONTACT_RECEIVER=info@barakahperlite.com

# Private portal and analytics
# DATABASE_URL must point to a real PostgreSQL database before going online.
# Vercel/Neon may also provide POSTGRES_* variables. The app resolves them
# safely in this order:
# runtime: DATABASE_URL -> POSTGRES_PRISMA_URL -> POSTGRES_URL
# Prisma CLI/migrations: DATABASE_URL_UNPOOLED -> POSTGRES_URL_NON_POOLING -> DATABASE_URL -> POSTGRES_PRISMA_URL -> POSTGRES_URL
# After configuring DATABASE_URL, run:
# npx prisma migrate deploy
# npm run db:seed
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL_UNPOOLED=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Private admin sessions and seed-only setup.
# SESSION_SECRET must be a long random secret and must be rotated before production.
# SEED_ADMIN_PASSWORD is used only by the seed script, never by runtime login.
SESSION_SECRET=replace-with-a-random-64-character-secret
NEXT_PUBLIC_SITE_URL=https://barakahperlite.com
SEED_ADMIN_EMAILS=elmarjou@hotmail.com
SEED_ADMIN_PASSWORD=change_me_to_a_strong_random_password
# Optional one-time recovery flag. Keep false in normal production deploys so
# redeploys do not reset existing admin passwords.
SEED_ADMIN_FORCE_RESET=false

# Durable server-side rate limiting for public/auth endpoints.
# Create an Upstash Redis database and add these values in Vercel Project Settings.
UPSTASH_REDIS_REST_URL=https://YOUR-UPSTASH-REDIS-REST-URL
UPSTASH_REDIS_REST_TOKEN=YOUR-UPSTASH-REDIS-REST-TOKEN

# Cloudflare Turnstile anti-spam protection.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is public by design; TURNSTILE_SECRET_KEY is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY

# Vercel Blob storage for admin-managed Hero Agriculture images.
# Create a Blob store: Vercel Project -> Storage -> Blob. The token is then
# auto-injected in Preview/Production. For local dev, run `vercel env pull`
# or paste the token below. Without it, image uploads return HTTP 503.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_TOKEN
